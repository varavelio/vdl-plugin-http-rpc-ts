@httpRpc
type Service {
  @proc
  ping {}

  @proc
  clearCache {
    input {
      namespace string
    }
  }

  @proc
  rotateKeys {
    output {
      rotatedAt string
    }
  }

  @proc
  getUser {
    input {
      userId string
    }

    output {
      id string
      email string
    }
  }
}
