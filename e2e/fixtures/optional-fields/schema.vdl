type Address {
  street string
  city string
}

@httpRpc
type Service {
  @proc
  echo {
    input {
      required string
      optional? string
      optionalInt? int
      optionalBool? bool
      optionalArray? string[]
      optionalObject? Address
    }

    output {
      required string
      optional? string
      optionalInt? int
      optionalBool? bool
      optionalArray? string[]
      optionalObject? Address
    }
  }
}
